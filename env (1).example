:root{--bg:#08090c;--panel:#151518;--panel2:#1b1a1a;--line:#343136;--gold:#eab64e;--gold2:#a87527;--muted:#a6a2a0;--green:#5be078}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:#f6f2ed;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}body{padding-bottom:calc(78px + env(safe-area-inset-bottom));background:radial-gradient(ellipse at 50% 0%,#24202a 0,#09090c 52%)}button{font:inherit;color:inherit;border:0;cursor:pointer}#app{max-width:620px;margin:auto;min-height:100vh}.top{height:62px;display:flex;align-items:center;justify-content:space-between;padding:8px 17px;background:#09090cf2;border-bottom:1px solid #29262a;position:sticky;top:0;z-index:5}.brand{display:flex;align-items:center;gap:10px}.brand b{font-size:13px;letter-spacing:1.5px}.brand small{display:block;color:#99918b;font-size:9px;letter-spacing:2px;margin-top:3px}.crown{color:var(--gold);font-size:29px}.round{background:#242226;border:1px solid #454047;border-radius:50%;width:36px;height:36px;font-size:20px;color:var(--gold)}
main{padding:0 13px 20px}.hero{height:235px;margin:0 -13px 13px;position:relative;overflow:hidden;background:#111}.city{position:absolute;inset:0;background:linear-gradient(0deg,#09090c 0%,transparent 48%),linear-gradient(90deg,#09090caa,transparent 50%),url('https://images.unsplash.com/photo-1519501025264-65ba15a82390?auto=format&fit=crop&w=1200&q=85') center 42%/cover;filter:saturate(.65)}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,#09090c99,transparent 45%,#08090c)}.profile{position:relative;display:flex;align-items:center;gap:11px;padding:20px 15px}.avatar{width:61px;height:61px;border-radius:50%;display:grid;place-items:center;font-size:32px;color:var(--gold);border:2px solid var(--gold);background:radial-gradient(circle,#51402b,#0c0c0d);box-shadow:0 0 0 4px #1a1715}.who{display:flex;flex-direction:column;gap:4px;min-width:0}.who b{font-size:16px}.who span,.who small{font-size:11px;color:#c4bcb5}.who strong{color:var(--gold)}.xp{width:118px;height:6px;border-radius:8px;background:#050506;border:1px solid #4b4234;overflow:hidden}.xp i{display:block;height:100%;width:0;background:linear-gradient(90deg,#a66e22,#ffcf67)}.wallet{margin-left:auto;text-align:right;background:#111114d9;border:1px solid #66502f;border-radius:9px;padding:8px 10px}.wallet small,.stat small,.collect small{display:block;color:#aaa09a;font-size:9px;letter-spacing:1px;margin-bottom:5px}.wallet b{font-size:14px;color:var(--gold)}.hero-caption{position:absolute;bottom:16px;left:17px;display:flex;flex-direction:column;gap:5px}.hero-caption span{font-size:9px;letter-spacing:3px;color:var(--gold)}.hero-caption b{font-size:18px;text-shadow:0 2px 8px #000}
.panel{background:linear-gradient(135deg,#1d1b1b,#111114);border:1px solid var(--line);border-radius:13px;box-shadow:0 5px 18px #0005}.promo{display:flex;align-items:center;padding:13px;gap:12px;margin-bottom:10px}.promo-icon{font-size:31px;width:48px;text-align:center}.promo b{color:var(--gold);font-size:15px}.promo p{margin:4px 0 0;color:#aaa5a1;font-size:12px;line-height:1.35}.chev{margin-left:auto;color:var(--gold);font-size:30px}.stats{display:grid;grid-template-columns:1fr 1fr;gap:9px}.stat{padding:12px}.stat b{font-size:19px;color:var(--gold)}.green{color:var(--green)!important}.collect{display:flex;align-items:center;justify-content:space-between;margin-top:9px;padding:11px 13px}.collect b{font-size:18px;color:var(--gold)}.gold-btn{background:linear-gradient(135deg,#f5ca70,#b77b2c);color:#1b1208;font-weight:800;font-size:11px;letter-spacing:.7px;padding:11px 17px;border-radius:8px;box-shadow:0 3px 12px #c18b3940}.section-head{display:flex;align-items:center;justify-content:space-between;margin:22px 2px 10px}.section-head h2{font-size:19px;margin:0}.tag{font-size:9px;letter-spacing:1px;color:var(--gold);border:1px solid #6d542e;border-radius:20px;padding:5px 8px}
.asset-list{display:grid;gap:9px}.asset-card{display:grid;grid-template-columns:84px 1fr;overflow:hidden;min-height:112px}.asset-art{display:grid;place-items:center;font-size:43px;background:radial-gradient(circle at 50% 40%,#57402c,#15141a 70%);border-right:1px solid #383033}.asset-info{padding:11px;min-width:0}.asset-top{display:flex;justify-content:space-between;gap:5px;align-items:center}.asset-top b{font-size:14px}.level{font-size:10px;color:var(--gold)}.asset-info p{margin:6px 0;color:#aaa;font-size:11px}.asset-actions{display:flex;gap:7px;align-items:center;justify-content:space-between}.asset-actions small{color:var(--green);font-size:10px}.mini-btn{border:1px solid #b48742;background:#17130e;color:#f3c56c;border-radius:7px;padding:7px 10px;font-size:10px;font-weight:700}
.bottom{position:fixed;z-index:8;bottom:0;left:0;right:0;max-width:620px;margin:auto;display:grid;grid-template-columns:repeat(5,1fr);padding:8px 5px calc(8px + env(safe-area-inset-bottom));background:#0b0b0ff2;border-top:1px solid #363138;backdrop-filter:blur(12px)}.nav{background:transparent;color:#89858a;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:10px;padding:3px}.nav span{font-size:23px;line-height:25px}.nav.active{color:var(--gold)}.nav.active span{text-shadow:0 0 13px #eab64e99}
.view-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.tile{padding:13px;text-align:center}.tile .emoji{font-size:30px}.tile b{display:block;margin:6px 0;font-size:13px}.tile small{color:#aaa;font-size:10px}.tile .mini-btn{margin-top:10px}.job-card,.shop-row,.task-row{padding:13px;display:flex;align-items:center;gap:10px;margin-bottom:8px}.job-card .emoji,.shop-row .emoji{font-size:27px}.job-card .details,.shop-row .details{flex:1;min-width:0}.details b{font-size:13px}.details small{display:block;color:#aaa;font-size:10px;margin-top:4px}.locked{opacity:.45}.ranking{padding:13px;display:flex;justify-content:space-between;border-bottom:1px solid #333}.ranking:last-child{border:0}.ranking b{font-size:12px}.ranking small{color:var(--gold)}.empty{padding:25px;text-align:center;color:#aaa;font-size:12px}.hidden{display:none!important}.toast{position:fixed;z-index:20;bottom:90px;left:50%;transform:translate(-50%,20px);opacity:0;background:#24211e;border:1px solid #8e6b36;color:#f5d28a;padding:11px 16px;border-radius:9px;font-size:12px;max-width:90%;text-align:center;transition:.2s;pointer-events:none}.toast.show{opacity:1;transform:translate(-50%,0)}.loading{position:fixed;inset:0;z-index:30;background:#08090cf5;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;color:var(--gold);font-size:13px}.spinner{width:30px;height:30px;border:3px solid #55432b;border-top-color:#f2c36a;border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@media(min-width:500px){.hero{height:280px}.asset-card{grid-template-columns:115px 1fr}.asset-art{font-size:52px}}
